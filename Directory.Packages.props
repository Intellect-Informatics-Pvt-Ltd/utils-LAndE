<Project>

  <!-- Central Package Management: all NuGet versions pinned here -->
  <!-- See: https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management -->

  <!-- Multi-targeting note (2026-08-21): the Microsoft.AspNetCore.* packages are tied to a
       framework version - 10.0.0 simply will not install on net8.0 (NU1202) - so a package that
       ships for both frameworks has to select the matching version per target. Everything else
       here is version-agnostic and needs no condition. -->
  <PropertyGroup>
    <AspNetPackageVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.12</AspNetPackageVersion>
    <AspNetPackageVersion Condition="'$(TargetFramework)' != 'net8.0'">10.0.0</AspNetPackageVersion>
  </PropertyGroup>

  <ItemGroup Label="Intellect.Erp internal packages (consumed by Intellect.Erp.AllObservabilityAndTraceabilitys)">
    <!-- Floating versions: the meta-package always picks up whatever was just
         published by build_push_script.sh in the same workflow run. -->
    <PackageVersion Include="Intellect.Erp.ErrorHandling" Version="*" />
    <PackageVersion Include="Intellect.Erp.Observability.Abstractions" Version="*" />
    <PackageVersion Include="Intellect.Erp.Observability.AspNetCore" Version="*" />
    <PackageVersion Include="Intellect.Erp.Observability.AuditHooks" Version="*" />
    <PackageVersion Include="Intellect.Erp.Observability.Core" Version="*" />
    <PackageVersion Include="Intellect.Erp.Observability.Integrations.Messaging" Version="*" />
    <PackageVersion Include="Intellect.Erp.Observability.Integrations.Traceability" Version="*" />
    <PackageVersion Include="Intellect.Erp.Observability.Log4NetBridge" Version="*" />
    <PackageVersion Include="Intellect.Erp.Observability.Propagation" Version="*" />
    <PackageVersion Include="Intellect.Erp.Observability.Testing" Version="*" />
  </ItemGroup>

  <ItemGroup Label="Microsoft.Extensions.*">
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Serilog 3.x ecosystem">
    <PackageVersion Include="Serilog" Version="4.0.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="5.0.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="5.0.0" />
    <PackageVersion Include="Serilog.Sinks.Elasticsearch" Version="10.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageVersion Include="Serilog.Enrichers.Process" Version="3.0.0" />
  </ItemGroup>

  <ItemGroup Label="Serialization and configuration">
    <PackageVersion Include="System.Text.Json" Version="10.0.0" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>

  <ItemGroup Label="ASP.NET Core">
    <PackageVersion Include="Microsoft.AspNetCore.WebUtilities" Version="$(AspNetPackageVersion)" />
  </ItemGroup>

  <ItemGroup Label="Legacy logging bridge">
    <!-- 3.1.0 carries GHSA-4f7c-pmjv-c25w (moderate). The csproj comment said it was
         "required for legacy bridge" and suppressed it; 3.2.0 is the patched release and
         the bridge builds against it, so the suppression is no longer needed. -->
    <PackageVersion Include="log4net" Version="3.3.2" />
  </ItemGroup>

  <ItemGroup Label="Testing: xUnit">
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
  </ItemGroup>

  <ItemGroup Label="Testing: assertions and property-based">
    <PackageVersion Include="FluentAssertions" Version="6.12.2" />
    <PackageVersion Include="FsCheck" Version="2.16.6" />
    <PackageVersion Include="FsCheck.Xunit" Version="2.16.6" />
  </ItemGroup>

  <ItemGroup Label="Testing: ASP.NET Core integration">
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(AspNetPackageVersion)" />
  </ItemGroup>

  <ItemGroup Label="Benchmarking">
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

</Project>
